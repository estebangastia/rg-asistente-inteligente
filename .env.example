# ── Base de datos ─────────────────────────────────────────
# Ajustar host/puerto/usuario/password segun la instalacion local de PostgreSQL.
# IMPORTANTE: en Windows con PostgreSQL instalado via el instalador oficial,
# el puerto puede ser 5432 o 5433 si hay mas de una instancia instalada.
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/rg_asistente

# ── Modelo de lenguaje del asistente (opcional) ───────────
# Cualquier API compatible con OpenAI. Sin LLM_API_KEY el asistente responde
# con el motor de reglas local (la demo funciona igual, sin internet).
#
#   Groq (gratis, sin tarjeta): crear la key en https://console.groq.com/keys
#     LLM_PROVIDER=groq            → modelo por defecto: openai/gpt-oss-120b
#   OpenAI (produccion, pago):
#     LLM_PROVIDER=openai          → modelo por defecto: gpt-4o
#   Google Gemini (gratis): https://aistudio.google.com/apikey
#     LLM_PROVIDER=gemini          → modelo por defecto: gemini-2.5-flash
#   OpenRouter (modelos :free):
#     LLM_PROVIDER=openrouter
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=                      (opcional: otro modelo del proveedor)
# LLM_BASE_URL=                   (opcional: otro proveedor compatible)
LLM_TIMEOUT_SECONDS=20

# Solo para la variante con busqueda semantica (app/rag_engine_openai.py)
OPENAI_API_KEY=sk-...

# ── JWT ───────────────────────────────────────────────────
# Generar una clave propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esto_por_una_clave_segura_de_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# ── Politica de acceso (seccion Seguridad del TFG) ───────
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15
DIAS_VIGENCIA_PASSWORD=90
PASSWORDS_HISTORIAL=3

# ── Respaldo ──────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENCION_DIAS=7
# Carpeta de pg_dump / pg_restore si no estan en el PATH. En Windows se
# detecta sola si PostgreSQL esta en C:\Program Files\PostgreSQL\<version>\bin
# PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin

# ── Email SMTP (opcional para la demo) ───────────────────
# Si SMTP_USER queda vacio, las notificaciones se registran pero no se envian
# y la contrasena inicial de un usuario nuevo se muestra en pantalla.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notificaciones@rg-sa.com.ar
